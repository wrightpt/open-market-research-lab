{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic research job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submission",
    "split",
    "resources",
    "max_price_cents"
  ],
  "properties": {
    "submission": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "budget": {
          "additionalProperties": false,
          "properties": {
            "max_bars": {
              "const": 1000,
              "type": "integer"
            },
            "parameter_sets": {
              "const": 1,
              "type": "integer"
            }
          },
          "required": [
            "max_bars",
            "parameter_sets"
          ],
          "type": "object"
        },
        "dataset": {
          "additionalProperties": false,
          "properties": {
            "development_sha256": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "holdout_sha256": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "const": "synthetic-liquidity-v1",
              "type": "string"
            }
          },
          "required": [
            "id",
            "development_sha256",
            "holdout_sha256"
          ],
          "type": "object"
        },
        "evaluation": {
          "additionalProperties": false,
          "properties": {
            "drawdown_fraction": {
              "maximum": 0.5,
              "minimum": 0.001,
              "type": "number"
            },
            "horizon_bars": {
              "maximum": 24,
              "minimum": 2,
              "type": "integer"
            },
            "sampling": {
              "const": "non_overlapping_horizons",
              "type": "string"
            }
          },
          "required": [
            "horizon_bars",
            "drawdown_fraction",
            "sampling"
          ],
          "type": "object"
        },
        "execution": {
          "additionalProperties": false,
          "properties": {
            "fee_bps": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "initial_cash": {
              "maximum": 1000000,
              "minimum": 100,
              "type": "number"
            },
            "position": {
              "const": "long_or_cash",
              "type": "string"
            },
            "slippage_bps": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "terminal_exit": {
              "const": "last_close_with_costs",
              "type": "string"
            },
            "timing": {
              "const": "next_open",
              "type": "string"
            }
          },
          "required": [
            "initial_cash",
            "fee_bps",
            "slippage_bps",
            "timing",
            "position",
            "terminal_exit"
          ],
          "type": "object"
        },
        "hypothesis": {
          "maxLength": 1200,
          "minLength": 20,
          "type": "string"
        },
        "research": {
          "additionalProperties": false,
          "properties": {
            "acceptance_criteria": {
              "maxLength": 1200,
              "minLength": 20,
              "type": "string"
            },
            "development_trials": {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            "evidence_level": {
              "const": "synthetic_engineering_only",
              "type": "string"
            },
            "holdout_rule": {
              "const": "freeze_then_one_pass_no_retuning",
              "type": "string"
            },
            "limitations": {
              "maxLength": 2000,
              "minLength": 20,
              "type": "string"
            },
            "prior_work": {
              "maxLength": 1200,
              "minLength": 20,
              "type": "string"
            }
          },
          "required": [
            "development_trials",
            "prior_work",
            "acceptance_criteria",
            "limitations",
            "holdout_rule",
            "evidence_level"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "strategy": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "liquidity_guard_v1",
              "type": "string"
            },
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "depth_ratio_max": {
                  "maximum": 1,
                  "minimum": 0.1,
                  "type": "number"
                },
                "lookback_bars": {
                  "maximum": 48,
                  "minimum": 4,
                  "type": "integer"
                },
                "min_signals": {
                  "maximum": 3,
                  "minimum": 1,
                  "type": "integer"
                },
                "oi_drop_min": {
                  "maximum": 0.5,
                  "minimum": 0.001,
                  "type": "number"
                },
                "spread_ratio_min": {
                  "maximum": 5,
                  "minimum": 1,
                  "type": "number"
                }
              },
              "required": [
                "lookback_bars",
                "spread_ratio_min",
                "depth_ratio_max",
                "oi_drop_min",
                "min_signals"
              ],
              "type": "object"
            }
          },
          "required": [
            "name",
            "parameters"
          ],
          "type": "object"
        },
        "submission_id": {
          "maxLength": 64,
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9-]{2,63}$",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "submission_id",
        "title",
        "hypothesis",
        "dataset",
        "strategy",
        "execution",
        "evaluation",
        "budget",
        "research"
      ],
      "title": "Bounded local strategy submission v1",
      "type": "object"
    },
    "split": {
      "type": "string",
      "const": "development"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_seconds",
        "wall_seconds",
        "memory_mib",
        "output_bytes",
        "gpu"
      ],
      "properties": {
        "cpu_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 128,
          "maximum": 256
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 16384,
          "maximum": 524288
        },
        "gpu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        }
      }
    },
    "max_price_cents": {
      "type": "integer",
      "minimum": 50,
      "maximum": 200
    }
  }
}
